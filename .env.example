# 현재 웹 앱은 환경설정에서 사용자 키를 입력하므로 이 파일이 필요하지 않습니다.
# 아래 키는 기존 서버 API를 별도 사용할 때만 설정합니다.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-transcribe
AI_MODEL=gpt-4o-mini
HOST=127.0.0.1
PORT=3000
# 외부 배포: HTTPS 프록시 뒤에서 아래 값을 설정하세요.
